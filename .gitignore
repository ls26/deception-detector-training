# ── Caches & environments ──
.venv
.cache/
.uv-cache/
.uv-python/
hf_cache/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/

# ── IDE / local tooling ──
.claude/
.cursor/
.cursor-extensions/
.jupyter/
.vscode/

# ── Secrets (API keys, tokens) ──
.env
atlas_setup.sh
.secrets.env
dotfiles/
.claude-global/

# ── Local-only project instructions (not committed) ──
CLAUDE.md

# ── Public release copies (committed in a separate repo; never commit here) ──
probes-as-training-signals/
release_checks/
docs/RELEASE_PLAN.md
docs/RELEASE_HANDOFF.md

# ── Large run outputs ──
results/
artifacts/
scratch/

# ── Top-level junk files ──
*.log
*.pdf

# ── obfuscation-atlas build/runtime artifacts ──
obfuscation-atlas/.venv
obfuscation-atlas/__pycache__/
obfuscation-atlas/*.egg-info/
obfuscation-atlas/wandb/
obfuscation-atlas/outputs/
obfuscation-atlas/test-results/
obfuscation-atlas/.wandb_cache/
obfuscation-atlas/artifacts/
obfuscation-atlas/checkpoints/
obfuscation-atlas/.claude
obfuscation-atlas/.DS_Store
obfuscation-atlas/output.txt
obfuscation-atlas/vaibhav.txt
obfuscation-atlas/Solution.py
obfuscation-atlas/.cursorrules

# ── Experiment binary artifacts (keep code/configs, exclude regenerable data) ──
*.memmap
*.pt
**/buffer/
**/buffer_*/
# Derived outputs are ignored by pattern family, so a variant folder
# (probe_weights_maj3/, activations_wd01/, ...) is covered without editing this list.
**/probe_weights*/
**/probe_activations*/
**/activations*/
**/*_activations/
experiments/**/*.log
*.bak

# ── Experiment generated data (probe manifests, split JSONs — large & regenerable) ──
**/probe_train_dataset.json
**/*split*.json
**/metadata.json
**/shared_eval_sets/*.jsonl
sycophancy_experiments/**/completions/
sycophancy_experiments/**/completions.jsonl
sycophancy_experiments/**/followups/
sycophancy_experiments/**/followups.jsonl
# Per-rollout scored records (18-42 MB each) and the enumerated measurement set
# (21 MB). Both are derived: cue_set.jsonl is rebuilt instantly by
# build_domain_set.py, deception_scores.jsonl by score_followups.py. The metrics
# CSVs they feed are committed.
sycophancy_experiments/**/deception_scores.jsonl
sycophancy_experiments/**/cue_set.jsonl

# Probe train/eval sets (36 MB): they embed the rollout prompt/completion/follow-up
# text that completions.jsonl and followups.jsonl are already excluded for, and are
# rebuilt deterministically (seeded) by each probe experiment's step 1. Variant folders
# (probe_sets_maj3/, ...) are covered by the wildcard; their manifests stay tracked.
sycophancy_experiments/**/probe_sets*/*.jsonl
# Console dumps and superseded dry-run metrics from the probe-training scripts.
sycophancy_experiments/**/analysis_output.txt
sycophancy_experiments/**/probe_metrics_dry_run.json
# Probe sets nested one level down (260923+: probe_sets/<variant>/*.jsonl, up to 20 MB
# each); manifests stay tracked.
sycophancy_experiments/**/probe_sets*/**/*.jsonl
# Cross-validation held-out logits (260924+: one file per probe x grid cell x fold,
# ~70 MB per sweep), regenerated by cv_sweep.py. The selection outputs beside them
# (selection.json, folds.json, summary.md, chosen_overrides*.json) stay tracked.
sycophancy_experiments/**/cv/**/fold[0-9]*.json
# Smoke-test outputs of the probe-training scripts.
sycophancy_experiments/**/logs/smoke/
# 261007+: generation passes (gens/<gen>/turn1.jsonl, 34-63 MB), float32 P(Yes) sidecars
# and per-arm label files (arms/<arm>/labels.jsonl, up to 46 MB) embed the rollout text
# that completions.jsonl / followups.jsonl / probe sets are already excluded for. All are
# rebuilt by generate_turn1.py, score_pyes.py and label.py; their summary JSONs, baselines
# and sizes.json stay tracked.
sycophancy_experiments/**/gens/**/turn1.jsonl
sycophancy_experiments/**/pyes_fp32.jsonl
# Per-row label files at any depth (261010 writes labels.jsonl at the folder top level),
# as .claude/rules/sycophancy-experiments.md states; all are regenerated by a script.
sycophancy_experiments/**/labels.jsonl
sycophancy_experiments/**/arms*/**/none_answers.json
# Dry-run and fixture leftovers (261007's gens/*_dry*/ and arms_dry*/, and any later *_dry*/ folder).
sycophancy_experiments/**/*_dry*/
# Console dumps saved beside the logs (261012+); the step's JSON record stays tracked.
sycophancy_experiments/**/logs/*.txt
# Dry-run folders named dry/ (261010+).
sycophancy_experiments/**/dry/
sycophancy_experiments/**/tests_fixture/
# Unattended-run infrastructure and dry-run probe sets; never committed (runs.md stays tracked).
sycophancy_experiments/**/KICKOFF.md
sycophancy_experiments/**/HANDOFF*.md
sycophancy_experiments/**/kickoff_prompt.txt
sycophancy_experiments/**/frozen_files.txt
sycophancy_experiments/**/watchdog.sh
sycophancy_experiments/**/dry_run/
# Stand-in run folders of links into /workspace/results/ that point an eval at another probe (261028+).
sycophancy_experiments/**/stand_in/
